# OpenAI-compatible relay
LLM_PROVIDER=custom
LLM_API_KEY=your-relay-api-key
LLM_MODEL=your-model-name
LLM_BASE_URL=https://your-relay-host/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
# Optional provider-neutral fallback for transient primary-model failures.
# LLM_FALLBACK_PROVIDER=custom
# LLM_FALLBACK_API_KEY=your-fallback-key
# LLM_FALLBACK_MODEL=your-fallback-model
# LLM_FALLBACK_BASE_URL=https://fallback-host/v1

# Local development defaults (Docker Compose exposes these ports on the host)
ENVIRONMENT=dev
API_WORKERS=1
DATABASE_URL=mysql+asyncmy://health:health@127.0.0.1:3307/health_assistant
REDIS_URL=redis://127.0.0.1:6380/0
JWT_SECRET=replace-with-a-long-random-secret
AUTH_REQUIRED=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Redis cache, rate limiting, and distributed locks
CACHE_KEY_PREFIX=smart-health
CACHE_VERSION=1
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_RAG_TTL_SECONDS=900
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
LOCK_TIMEOUT_SECONDS=180
LOCK_BLOCKING_TIMEOUT_SECONDS=2
AGENT_TASK_MAX_RETRIES=2
AGENT_TASK_RETRY_BACKOFF_SECONDS=1

# MinIO/S3 report storage (the API stores only object metadata in MySQL)
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9002
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-random-secret
OBJECT_STORAGE_BUCKET=health-reports
OBJECT_STORAGE_SECURE=false
REPORT_RETENTION_DAYS=7
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required before storing non-empty sensitive profile fields in production.
DATA_ENCRYPTION_KEY=
MAX_INPUT_CHARS=16000
MAX_IMAGE_PIXELS=20000000
MAX_REPORT_FILE_BYTES=20971520
# vision is the verified fallback. Configure MinerU for PDFs and PaddleOCR for report images.
OCR_PROVIDER=vision
MINERU_ENDPOINT=
PADDLEOCR_ENDPOINT=
OCR_TIMEOUT_SECONDS=180

# Tool execution policy
TOOL_TIMEOUT_SECONDS=30
TOOL_MAX_RETRIES=1

# RAG
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=rag/chroma_db

# Optional vision override
# VISION_PROVIDER=custom
# VISION_API_KEY=your-vision-api-key
# VISION_MODEL=your-vision-model
# VISION_BASE_URL=https://your-relay-host/v1
